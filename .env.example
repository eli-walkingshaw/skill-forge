# skill-forge configuration
# Copy to .env and fill in your values

# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...

# Where your Obsidian vault for skill-forge lives
VAULT_PATH=/Users/eli/ObsidianVaults/skill-forge

# Where the Git repo for approved skills lives (will be created if missing)
# Claude Code reads skills from here (or from a symlink that points here)
SKILLS_REPO_PATH=/Users/eli/code/claude-skills

# --- Sources ---
# Comma-separated list of source types: claude-code, inbox, claude-ai-exports
SOURCES=claude-code,inbox

# Where Claude Code stores session logs (default location on macOS/Linux)
CLAUDE_CODE_LOGS_PATH=/Users/eli/.claude/projects

# How many days back to scan on each run
SCAN_DAYS_BACK=7

# --- Clustering ---
# Minimum number of captures to form a cluster
CLUSTER_MIN_SIZE=3

# Similarity threshold (0.0–1.0). Higher = stricter matching.
CLUSTER_SIMILARITY_THRESHOLD=0.45

# --- Drafting ---
# Model to use for SKILL.md generation
DRAFT_MODEL=claude-opus-4-7

# --- Git sync ---
# Auto-push after committing? Set to false if you want to review pushes manually.
GIT_AUTO_PUSH=true
GIT_REMOTE=origin
GIT_BRANCH=main
\n# --- Gates ---\n# Quality/sensitivity/effectiveness checks before install. See forge/gates.py.\nGATES_ENABLED=true\nGATES_BLOCK_THIN_DRAFTS=true\nGATES_EFFECTIVENESS_ENABLED=true\n
# --- Stacks ---
# Per-stack target repo URLs. Empty/missing = local-only generation.
STACK_REPO_engineering=
STACK_REPO_data=
STACK_REPO_operations=
